# 管理员账号（首次启动创建；修改后重启即同步生效，也可在管理台左下角修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 会话/密码 cookie 签名密钥 —— 务必替换为长随机字符串（如：openssl rand -hex 32）
SESSION_SECRET=replace-with-a-long-random-string
# 访客统计标识的哈希密钥。修改会让后续访客被视为新的 UV。
ANALYTICS_SALT=replace-with-a-separate-long-random-string
# 公开链接完整基址。Example: https://page.example.com
PUBLIC_BASE_URL=
# 容器时区（仅 Docker 部署时生效）
TZ=Asia/Shanghai
